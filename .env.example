# Set these to the Raspberry Pi user's IDs from `id -u` and `id -g`.
HOST_UID=1000
HOST_GID=1000

# Discord bot token and the numeric ID of a dedicated private text channel.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# How often successful usage is saved to the SD card. Changes need a container recreate, not a rebuild.
STATE_SAVE_INTERVAL=30m

# Host paths for running `go run ./cmd/bot` from the repository root.
# Docker Compose uses its own container paths for these variables.
ACCOUNTS_ROOT=${HOME}/.codex-accounts
CONFIG_PATH=./config/config.json
STATE_PATH=./data/dev-state.json
